# Local Quantrade configuration. Copy to .env and replace placeholder values.
QUANTRADE_ENVIRONMENT=development

# PostgreSQL database created for Quantrade.
DATABASE_URL=postgresql://postgres:replace-with-local-password@localhost:5432/quantdb

# Use an absolute file URI. On Windows, retain the third slash before the drive.
RAW_ARTIFACTS_URI=file:///D:/path/to/Quantrade/data/raw

# Required for SEC EDGAR retrieval. Use a real contact address.
SEC_USER_AGENT=Quantrade research contact@example.com

# Required together for Alpaca retrieval.
MARKET_DATA_PROVIDER=alpaca
APCA_API_KEY_ID=replace-with-alpaca-key
APCA_API_SECRET_KEY=replace-with-alpaca-secret

# Optional until macro/vintage data is enabled.
FRED_API_KEY=
