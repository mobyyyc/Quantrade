# Copy this file to .env locally. Do not commit .env or any credentials.
QUANTRADE_ENVIRONMENT=development
DATABASE_URL=postgresql://quantrade:replace-me@localhost:5432/quantrade
# The web API reads the same normalized score and governance tables through DATABASE_URL.
RAW_ARTIFACTS_URI=file:///replace/with/local/object-storage/path

# SEC requests should identify the application and a contact email.
SEC_USER_AGENT=Quantrade Research contact@example.com

# Conditional free-data credentials. Leave blank until their provider audits begin.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
FRED_API_KEY=
