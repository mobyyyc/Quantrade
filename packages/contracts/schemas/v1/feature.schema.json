{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantrade.local/contracts/v1/feature.schema.json",
  "title": "Quantrade immutable feature definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "featureKey", "featureVersion", "family", "direction", "displayName", "description", "formula", "requiredInputs", "asOfRule", "definitionHash"],
  "properties": {
    "contractVersion": { "const": "v1" },
    "featureKey": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "featureVersion": { "type": "string", "minLength": 1 },
    "family": { "enum": ["momentum", "value", "profitability", "risk", "liquidity"] },
    "direction": { "enum": ["higher_is_better", "lower_is_better"] },
    "displayName": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "formula": { "type": "string", "minLength": 1 },
    "requiredInputs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "asOfRule": { "type": "string", "minLength": 1 },
    "definitionHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
