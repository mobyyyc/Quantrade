{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantrade.local/contracts/v1/security.schema.json",
  "title": "Quantrade security and listing records",
  "oneOf": [
    { "$ref": "#/$defs/security" },
    { "$ref": "#/$defs/listing" }
  ],
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "sourceReference", "retrievedAt", "rawArtifactUri"],
      "properties": {
        "provider": { "enum": ["sec_edgar", "alpaca", "fred", "alfred", "manual"] },
        "sourceReference": { "type": "string", "minLength": 1 },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "rawArtifactUri": { "type": "string", "minLength": 1 }
      }
    },
    "identifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifierType", "value"],
      "properties": {
        "identifierType": { "enum": ["ticker", "cik", "figi", "isin"] },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "securityId", "issuerName", "assetClass", "countryCode", "identifiers", "validFrom", "source", "ingestedAt"],
      "properties": {
        "contractVersion": { "const": "v1" },
        "securityId": { "type": "string", "minLength": 1 },
        "issuerName": { "type": "string", "minLength": 1 },
        "assetClass": { "const": "common_stock" },
        "countryCode": { "const": "US" },
        "identifiers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/identifier" } },
        "validFrom": { "type": "string", "format": "date" },
        "validTo": { "type": "string", "format": "date" },
        "source": { "$ref": "#/$defs/source" },
        "ingestedAt": { "type": "string", "format": "date-time" }
      }
    },
    "listing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "listingId", "securityId", "ticker", "exchangeMic", "currency", "validFrom", "source", "ingestedAt"],
      "properties": {
        "contractVersion": { "const": "v1" },
        "listingId": { "type": "string", "minLength": 1 },
        "securityId": { "type": "string", "minLength": 1 },
        "ticker": { "type": "string", "pattern": "^[A-Z][A-Z. -]{0,14}$" },
        "exchangeMic": { "type": "string", "pattern": "^[A-Z]{4}$" },
        "currency": { "const": "USD" },
        "validFrom": { "type": "string", "format": "date" },
        "validTo": { "type": "string", "format": "date" },
        "source": { "$ref": "#/$defs/source" },
        "ingestedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
